function renderPhase0() {
    const progression = getLevelProgression();
    const chopMax = progression.currentChopMax;
    const unreadCount = getUnreadNotificationCount();
    const badgeHtml = unreadCount > 0 
        ? `<span class="absolute -top-1 -right-1 bg-red-600 text-[10px] font-bold rounded-full h-5 w-5 flex items-center justify-center border border-white">${unreadCount}</span>` 
        : '';

    // FIX: Reduced padding and ensured max-width is strictly 100vw
    const menuContent = createElement('div', 'flex flex-col items-center w-full max-w-full mx-auto p-3 space-y-4 bg-black/20 rounded-2xl overflow-y-auto max-h-screen pb-32');

    // 1. TITLE ROW
    const titleRow = createElement('div', 'w-full text-center mt-2');
    // FIX: Changed text-5xl to text-3xl for mobile width
    const title = createElement('h3', 'text-3xl font-extrabold title-font text-neon-pink uppercase tracking-tighter mb-1', 'MAIN MENU');
    title.style.textShadow = '0 0 15px rgba(255, 0, 255, 0.6)';
    titleRow.appendChild(title);

    // 2. BIG ICON ROW 
    // FIX: Changed to a 2-row grid for mobile to prevent overflow
    const iconRow = createElement('div', 'w-full grid grid-cols-4 gap-2 pb-4 border-b border-white/10');
    iconRow.innerHTML = `
        <button onclick="setPhase(10,'San Francisco Map')" class="aspect-square bg-gray-800 rounded-xl border border-white/10 flex items-center justify-center text-xl shadow-xl">🗺️</button>
        <button onclick="setPhase(14,'')" class="aspect-square bg-gray-800 rounded-xl border border-white/10 flex items-center justify-center text-xl shadow-xl">🎒</button>
        <div class="relative aspect-square bg-gray-800 rounded-xl border border-white/10 flex items-center justify-center text-xl shadow-xl" onclick="setPhase(16)">
            📱 ${badgeHtml}
        </div>
        <div class="aspect-square bg-gray-800 rounded-xl border border-white/10 flex items-center justify-center text-xl shadow-xl" onclick="setPhase(0, 'Game Menu')">
            ⚙️ 
        </div>
        <div class="col-span-4 py-2 bg-yellow-500/10 border-2 border-yellow-500 rounded-xl flex justify-center items-center shadow-lg">
            <span class="text-yellow-400 font-black title-font text-xl">$${game.score.toLocaleString()}</span>
        </div>
    `;

    // 3. PERSISTENCE ROW
    // FIX: Changed to grid-cols-2 to ensure buttons stay side-by-side without text wrap
    const persistenceRow = createElement('div', 'w-full grid grid-cols-2 gap-2 py-3 border-t border-b border-white/10 bg-white/5');
    const saveBtn = createElement('button', 'flex justify-center items-center space-x-1 py-2 rounded-full text-[10px] font-bold text-gray-300 uppercase bg-white/5', `<span>💾</span> <span>Save</span>`);
    saveBtn.onclick = saveGame;
    const loadBtn = createElement('button', 'flex justify-center items-center space-x-1 py-2 rounded-full text-[10px] font-bold text-gray-300 uppercase bg-white/5', `<span>📂</span> <span>Load</span>`);
    loadBtn.onclick = loadGame;
    persistenceRow.append(saveBtn, loadBtn);

    const assetsContainer = createElement('div', 'w-full flex flex-col space-y-4 py-2');
    const acquiredItems = game.inventory_items.filter(item => item.acquired);
    const acquiredTopics = game.conversation_topics.unlocked.filter(item => item.acquired);

    // FIX: Added overflow-x-auto so icons don't break the screen width
    const renderAssetRow = (label, items) => `
        <div class="w-full">
            <span class="text-[9px] font-mono text-gray-500 uppercase block mb-1">${label}</span>
            <div class="flex gap-2 overflow-x-auto pb-1 no-scrollbar">
                ${items.map(item => `
                    <div class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-gray-800/50 rounded-lg border border-white/10 text-xl">${item.icon}</div>
                `).join('') || '<span class="text-[10px] text-gray-700 uppercase italic">Empty</span>'}
            </div>
        </div>
    `;

    assetsContainer.innerHTML = renderAssetRow('Active Inventory', acquiredItems) + renderAssetRow('Active Topics', acquiredTopics);

    // 4. STATS SECTION
    // FIX: Removed grid-cols-2 for mobile to keep everything in one vertical column
    const statsSection = createElement('div', 'w-full space-y-6 pt-2');
    const playerStats = createElement('div', 'space-y-4');
    
    const chopsHtml = game.chops.filter(c => c.isUnlocked).map(chop => {
        const percentage = Math.min(100, Math.max(0, (chop.points / chopMax) * 100));
        return `
            <div class="w-full">
                <div class="flex justify-between text-[10px] mb-1">
                    <span class="text-gray-300">${chop.icon} ${chop.name}</span>
                    <span class="text-yellow-400 font-bold">${chop.points}/${chopMax}</span>
                </div>
                <div class="w-full bg-gray-800 h-1.5 rounded-full border border-gray-600 overflow-hidden">
                    <div class="bg-indigo-500 h-full" style="width: ${percentage}%"></div>
                </div>
            </div>`;
    }).join('');

    playerStats.innerHTML = `
        <div class="p-3 bg-gray-800/50 rounded-xl border border-indigo-500/30">
            <p class="text-[9px] font-mono text-gray-400 mb-1">PLAYER RANK</p>
            <div class="flex items-center justify-between">
                <div class="flex items-end space-x-2">
                    <span class="text-3xl font-bold text-indigo-400 leading-none">${game.level}</span>
                    <span class="text-sm text-gray-200 uppercase tracking-tighter">${game.rank}</span>
                </div>
                <div class="w-24 bg-gray-900 h-1.5 rounded-full border border-indigo-900 overflow-hidden">
                    <div class="bg-indigo-500 h-full" style="width: ${progression.progressPercentage}%"></div>
                </div>
            </div>
        </div>
        <div class="space-y-2">
            <h4 class="text-[10px] font-bold text-neon-pink uppercase tracking-widest">Artistic Caliber</h4>
            ${chopsHtml}
        </div>
    `;

    const socialStats = createElement('div', 'space-y-4');
    socialStats.innerHTML = `
        <div class="p-3 bg-fuchsia-900/20 rounded-xl border border-fuchsia-500/50 text-center">
            <p class="text-[9px] font-mono text-fuchsia-400 mb-1 uppercase tracking-widest">Audience Hype</p>
            <p class="text-3xl font-black text-fuchsia-400">${game.fans.toLocaleString()}</p>
        </div>
        
        <div class="p-3 bg-gray-800/50 rounded-xl border border-neon-pink/30">
            <p class="text-[9px] font-mono text-neon-pink mb-2 uppercase tracking-widest text-center">Memories</p>
            <div class="grid grid-cols-5 gap-1">
                ${Object.entries(game.memories)
                    .filter(([type, count]) => count > 0)
                    .map(([type, count]) => `
                    <div class="flex flex-col items-center p-1 bg-gray-900 rounded-lg border border-white/10">
                        <span class="text-sm">${memoryComponentMatrix[type]?.emoji || '❓'}</span>
                        <span class="text-[10px] font-bold text-yellow-400">${count}</span>
                    </div>
                `).join('')}
            </div>
        </div>
    `;
    statsSection.append(playerStats, socialStats);

    // 6. BUTTON GRID
    const debugTitle = createElement('p', 'text-[9px] font-mono text-fuchsia-400 mb-2 uppercase tracking-widest text-center', 'System Functions');
    const buttonGrid = createElement('div', 'grid grid-cols-3 gap-2 w-full');
    
    const menubuttons = [
        { title: 'TRIVIA', iconEmoji: '💡', action: () => initiateTrivia() },
        { title: 'WORDLE', iconEmoji: '📝', action: () => setPhase(7,'Wordle') },
        { title: 'SONGS', iconEmoji: '🎶', action: () => setPhase(8,'Songs') },
        { title: 'JUST ONE', iconEmoji: '1️', action: () => setPhase(9,'Just One') },
        { title: 'CARDS', iconEmoji: '🃏', action: () => setPhase(20, 'Poker') },
        { title: 'FEUD', iconEmoji: '📊', action: () => setPhase(11, 'Family Feud') },
        { title: 'SHOP', iconEmoji: '🛒', action: () => setPhase(4, 'Shop') },
        { title: 'SETUP', iconEmoji: '📛', action: () => setPhase(18,'Name setup') },
        { title: 'CHOPS', iconEmoji: '📋', action: () => setPhase(17, 'Chops') }
    ];

    menubuttons.forEach(btn => {
        const button = createElement('button', 'bg-gray-800 border border-white/10 rounded-xl py-2 flex flex-col items-center justify-center active:bg-neon-pink/20 transition-all', 
            `<span class="text-xl">${btn.iconEmoji}</span><span class="text-[8px] font-bold uppercase">${btn.title}</span>`);
        button.onclick = btn.action;
        buttonGrid.appendChild(button);
    });

    menuContent.append(titleRow, iconRow, persistenceRow, assetsContainer, statsSection, debugTitle, buttonGrid);
    return menuContent;
}
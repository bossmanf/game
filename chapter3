function triggerFinale(choice) {
    // Apply final choice impacts
    if (choice === 'FRIENDSHIP_VISIT') { game.traits.relationship += 5; game.traits.community += 5; }
    if (choice === 'FRIENDSHIP_HEAL') { game.traits.relationship -= 5; game.traits.confidence += 5; }

    // Priority Check
    if (choice === 'MARRIAGE') return renderFinaleScreen('MARRIAGE');
    if (choice === 'TROUBADOUR') return renderFinaleScreen('TROUBADOUR');

    // Traits Logic Check
    const t = game.traits;
    
    if (t.motivation < 40 || t.confidence < 40) return renderFinaleScreen('CORPORATE');
    if (t.karma >= 80 && t.motivation >= 75) return renderFinaleScreen('ACTIVIST');
    if (t.community >= 70 && t.karma >= 60) return renderFinaleScreen('BESTIE');
    if (t.happiness >= 75 && t.confidence >= 60) return renderFinaleScreen('BACHELOR');
    
    return renderFinaleScreen('GHOST');
}


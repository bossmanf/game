// 3. Rendering Logic
function renderScenarioScreen() {
    const idx = game.currentScenario;
    const scenario = scenarioData[idx];
    
    // Handle Scenario 32 logic
    if (idx === 31) return renderCrossroads();

    const container = createElement('div', 'flex flex-col w-full h-full p-6 space-y-8 animate-in fade-in duration-500');

    // Traits Bar
    const traitsBar = createElement('div', 'grid grid-cols-3 md:grid-cols-6 gap-2 w-full p-4 bg-black/40 border border-white/10 rounded-xl mb-4');
    const traitList = [
        { k: 'relationship', n: 'Rel.', e: '❤️' },
        { k: 'community', n: 'Comm.', e: '🤝' },
        { k: 'karma', n: 'Karma', e: '✨' },
        { k: 'confidence', n: 'Conf.', e: '🛡️' },
        { k: 'motivation', n: 'Motiv.', e: '⚡' },
        { k: 'happiness', n: 'Happy', e: '☀️' }
    ];
    
    traitList.forEach(t => {
        const val = game.traits[t.k];
        traitsBar.innerHTML += `
            <div class="flex flex-col items-center">
                <span class="text-xs font-bold text-gray-500 uppercase">${t.n} ${t.e}</span>
                <span class="text-xl font-black text-white">${val}</span>
            </div>
        `;
    });

    // Content
    const scenarioBox = createElement('div', 'flex-1 flex flex-col items-center justify-center text-center space-y-6');
    scenarioBox.innerHTML = `
        <span class="text-cyan-400 font-mono text-[10px] tracking-[0.4em] uppercase">Scenario ${idx + 1} / 32</span>
        <h2 class="text-4xl font-black text-white italic tracking-tighter uppercase leading-none">${scenario.title}</h2>
        <p class="text-xl text-gray-300 max-w-xl font-medium leading-snug">"${scenario.desc}"</p>
    `;

    const choiceContainer = createElement('div', 'grid grid-cols-1 gap-4 w-full max-w-lg');
    scenario.choices.forEach((choice, cIdx) => {
        const btn = createElement('button', 'metal-button p-4 text-left group flex items-center justify-between');
        btn.innerHTML = `
            <span class="text-sm font-black uppercase italic">${choice.text}</span>
            <span class="opacity-0 group-hover:opacity-100 transition-opacity text-cyan-400">SELECT ▶</span>
        `;
        btn.onclick = () => handleChoice(choice);
        choiceContainer.appendChild(btn);
    });

    container.appendChild(traitsBar);
    container.appendChild(scenarioBox);
    container.appendChild(choiceContainer);
    
    return container;
}

function handleChoice(choice) {
    // 1. Update Traits with Capping
    const deltas = [];
    for (const [trait, value] of Object.entries(choice.impact)) {
        const oldVal = game.traits[trait];
        game.traits[trait] = Math.min(100, Math.max(0, oldVal + value));
        
        const emojiMap = { relationship: '❤️', community: '🤝', karma: '✨', confidence: '🛡️', motivation: '⚡', happiness: '☀️' };
        const nameMap = { relationship: 'Relationship', community: 'Community', karma: 'Karma', confidence: 'Confidence', motivation: 'Motivation', happiness: 'Happiness' };
        
        deltas.push({ name: nameMap[trait], emoji: emojiMap[trait], value });
    }

    // 2. Show Feedback
    showImpactFeedback(deltas, () => {
        // 3. Move forward
        if (choice.video) {
            playMovie(choice.video, "Experience Recorded.", 21); // Assuming 21 is Scenario Phase
        } else {
            advanceScenario();
        }
    });
}

function showImpactFeedback(deltas, callback) {
    const overlay = document.createElement('div');
    overlay.className = "fixed inset-0 z-[2000] flex items-center justify-center bg-black/90 backdrop-blur-md animate-in fade-in duration-300";
    
    const content = createElement('div', 'text-center space-y-6 transform animate-in zoom-in-95');
    
    let deltaHtml = '';
    deltas.forEach(d => {
        const colorClass = d.value > 0 ? 'text-green-400' : 'text-red-500';
        const sign = d.value > 0 ? '+' : '';
        deltaHtml += `
            <div class="flex items-center justify-center gap-4 animate-in slide-in-from-bottom-4">
                <span class="text-2xl">${d.emoji}</span>
                <span class="text-2xl font-black uppercase text-white">${d.name}</span>
                <span class="text-4xl font-black ${colorClass}">${sign}${d.value}</span>
            </div>
        `;
    });

    content.innerHTML = `
        <h3 class="text-cyan-400 font-mono text-xs tracking-widest uppercase mb-12">System Update</h3>
        <div class="space-y-4 mb-16">${deltaHtml}</div>
        <button id="impact-close" class="metal-button px-12 py-3">CONTINUE</button>
    `;

    overlay.appendChild(content);
    document.body.appendChild(overlay);

    overlay.querySelector('#impact-close').onclick = () => {
        overlay.remove();
        callback();
    };
}

function advanceScenario() {
    game.currentScenario++;
    if (game.currentScenario >= scenarioData.length) {
        // This shouldn't happen if Crossroads logic works
    } else {
        renderGame();
    }
}

